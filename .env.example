REDIS_URL=redis://localhost:6379/0

# "fake" (default) uses a canned response — no API calls, no cost, safe for
# local dev. Set to "claude" to get real fix suggestions.
LLM_PROVIDER=fake

# Only needed when LLM_PROVIDER=claude — get a key at console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
