REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://logtofix:logtofix@localhost:5432/logtofix

# "fake" (default) uses a canned response — no API calls, no cost, safe for
# local dev. Set to "claude" to get real fix suggestions.
LLM_PROVIDER=fake

# Only needed when LLM_PROVIDER=claude — get a key at console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# "fake" (default) uses a deterministic hash-based vector — no API calls,
# no cost, good for testing the retrieval mechanism but not similarity
# quality. Set to "openai" for real embeddings.
EMBEDDING_PROVIDER=fake

# Only needed when EMBEDDING_PROVIDER=openai — get a key at platform.openai.com
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Max requests per client IP per window on POST /logs/ingest
INGEST_RATE_LIMIT_MAX=100
INGEST_RATE_LIMIT_WINDOW_SECONDS=60

# The frontend's origin — CORS only allows requests from here, never a wildcard
FRONTEND_ORIGIN=http://localhost:5173

# Your Supabase project URL (Settings -> API -> Project URL) — used to fetch
# the public JWKS for verifying login tokens. No secret needed for this.
SUPABASE_URL=
